{
  "id": "terminal",
  "name": "Terminal",
  "description": "Хакерский терминал: чёрный фон, зелёный моноширинный текст, курсор и луч ЭЛТ.",
  "size": [1080, 1440],
  "texture": ["scanlines", "glow"],
  "vars": {
    "--bg": "#020603",
    "--text": "#3bf07a",
    "--muted": "#1f7a43",
    "--accent": "#ff5f5f",
    "--good": "#6effa0",
    "--info": "#5fd0ff",
    "--font-title": "'JetBrains Mono', monospace",
    "--font-body": "'JetBrains Mono', monospace",
    "--font-kicker": "'JetBrains Mono', monospace",
    "--title-weight": "700",
    "--title-case": "uppercase",
    "--title-color": "#3bf07a",
    "--title-size": "80px",
    "--title-shadow": "0 0 14px rgba(59,240,122,.6)",
    "--kicker-size": "32px",
    "--kicker-color": "#1f9a53",
    "--kicker-prefix": "'user@ixe:~$ '",
    "--sub-weight": "700",
    "--sub-size": "48px",
    "--sub-color": "#9effc0",
    "--sub-case": "uppercase",
    "--body-size": "34px",
    "--body-color": "#4fe088",
    "--bullet": "'[+]'",
    "--scan-color": "rgba(0,0,0,.3)",
    "--glow-color": "rgba(40,180,90,.1)",
    "--card-bg": "#0a140c",
    "--card-border": "1px solid #1f7a43",
    "--card-radius": "2px",
    "--card-shadow": "0 0 0 1px rgba(59,240,122,.15)",
    "--img-filter": "grayscale(.3) brightness(.95) sepia(.4) hue-rotate(60deg) saturate(1.3)",
    "--pill-bg": "rgba(59,240,122,.1)",
    "--pill-color": "#6effa0",
    "--pill-border": "1px solid #1f7a43",
    "--pill-radius": "2px",
    "--source-color": "#1f7a43",
    "--watermark-color": "rgba(59,240,122,.04)"
  },
  "css": ".subtitle::after{content:'_';animation:none;opacity:.7} ul.bullets li::before{color:var(--good)} .pill::before{content:''}"
}

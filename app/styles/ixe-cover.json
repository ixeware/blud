{
  "id": "ixe-cover",
  "name": "ixe Cover",
  "description": "Обложка: огромный глянцевый сине-градиентный заголовок, курсивный подзаголовок, крупное фото по центру.",
  "size": [1080, 1440],
  "texture": ["paper", "glow"],
  "vars": {
    "--bg": "#efefef",
    "--text": "#141414",
    "--muted": "#8c8c8c",
    "--accent": "#e81c1c",
    "--font-title": "'Archivo Black', sans-serif",
    "--title-case": "none",
    "--title-weight": "400",
    "--title-color": "transparent",
    "--title-gradient": "linear-gradient(180deg, #9fe0ff 0%, #2f8de0 45%, #1763b4 72%, #0d3f82 100%)",
    "--title-filter": "drop-shadow(0 3px 2px rgba(0,0,0,.35)) drop-shadow(0 0 1px rgba(255,255,255,.8))",
    "--cover-title-size": "150px",
    "--cover-sub-size": "58px",
    "--cover-align": "center",
    "--sub-style": "italic",
    "--sub-weight": "700",
    "--sub-case": "uppercase",
    "--sub-font": "'Inter', sans-serif",
    "--paper-opacity": ".45",
    "--glow-color": "rgba(255,255,255,.7)",
    "--img-shadow": "drop-shadow(0 18px 30px rgba(0,0,0,.28))",
    "--card-shadow": "0 14px 30px rgba(0,0,0,.2)"
  },
  "css": ".layout-cover .title{letter-spacing:-.01em;line-height:.95} .layout-cover .subtitle{margin-top:14px}"
}

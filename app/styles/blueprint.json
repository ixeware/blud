    "--accent": "#ff6b4a",
    "--good": "#57e39a",
    "--info": "#7fd0ff",
    "--font-title": "'Space Grotesk', sans-serif",
    "--font-kicker": "'JetBrains Mono', monospace",
    "--font-body": "'JetBrains Mono', monospace",
    "--title-weight": "700",
    "--title-size": "92px",
    "--title-color": "#ffffff",
    "--title-shadow": "0 2px 0 rgba(0,0,0,.3)",
    "--kicker-size": "32px",

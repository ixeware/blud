{
  "id": "vhs",
  "name": "VHS Report",
  "description": "Ретро-кассета: тёплый тёмный фон, скан-линии, Anton заголовок с хромой-аберрацией.",
  "size": [1080, 1440],
  "texture": ["scanlines", "noise", "vignette"],
  "vars": {
    "--bg": "linear-gradient(160deg, #1a1222 0%, #241326 50%, #120d1a 100%)",
    "--text": "#f3e9ff",
    "--muted": "#9a86b0",
    "--accent": "#ff4d6d",
    "--good": "#49f2b0",
    "--info": "#56c7ff",
    "--font-title": "'Anton', sans-serif",
    "--title-weight": "400",
    "--title-size": "108px",
    "--title-color": "#ffffff",
    "--title-spacing": "0.02em",
    "--title-shadow": "3px 0 0 #ff2e63, -3px 0 0 #1fe0ff",
    "--kicker-size": "34px",
    "--kicker-case": "uppercase",
    "--kicker-color": "#ff4d6d",
    "--kicker-weight": "700",
    "--sub-font": "'Anton', sans-serif",
    "--sub-size": "58px",
    "--sub-case": "uppercase",
    "--sub-color": "#ffe34d",
    "--body-size": "36px",
    "--body-color": "#e9dcf5",
    "--scan-color": "rgba(0,0,0,.22)",
    "--noise-opacity": ".09",
    "--vignette-color": "rgba(10,2,16,.6)",
    "--card-bg": "#f3e9ff",
    "--card-radius": "4px",
    "--card-shadow": "0 12px 30px rgba(0,0,0,.55)",
    "--img-filter": "saturate(1.15) contrast(1.05)",
    "--watermark-color": "rgba(255,77,109,.06)"
  },
  "css": ".kicker{letter-spacing:.14em} .subtitle{letter-spacing:.02em}"
}
